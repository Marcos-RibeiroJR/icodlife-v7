// ASO — Atestado de Saúde Ocupacional (NR-07). Emitido pelo médico examinador.
model Aso {
  id                 String         @id @default(uuid())
  doctorId           String         @map("doctor_id")
  doctor             Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientDoctorId    String?        @map("patient_doctor_id")
  patientDoctor      PatientDoctor? @relation(fields: [patientDoctorId], references: [id])
  companyId          String?        @map("company_id")
  company            Company?       @relation(fields: [companyId], references: [id])

  // Empresa
  companyName        String         @map("company_name")
  companyCnpj        String?        @map("company_cnpj")
  companyAddress     String?        @map("company_address")
  companyPhone       String?        @map("company_phone")

  // Trabalhador
  workerName         String         @map("worker_name")
  workerCpf          String?        @map("worker_cpf")
  workerRg           String?        @map("worker_rg")
  workerBirthDate    DateTime?      @map("worker_birth_date")
  workerSex          String?        @map("worker_sex")
  workerRole         String?        @map("worker_role")
  workerSector       String?        @map("worker_sector")
  workerRegistration String?        @map("worker_registration")
  admissionDate      DateTime?      @map("admission_date")

  // Exame
  examType           String         @map("exam_type")   // admissional|periodico|retorno|mudanca_funcao|demissional
  examDate           DateTime       @map("exam_date")
  jobDescription     String?        @db.Text @map("job_description")

  // Riscos e exames complementares (JSON)
  risks              Json           // string[]
  complementaryExams Json           @map("complementary_exams") // [{ name, result?, date? }]

  // Parecer médico
  result             String         // apto|apto_restricoes|inapto
  restrictions       String?        @db.Text
  observations       String?        @db.Text

  // Médico examinador
  doctorName         String         @map("doctor_name")
  doctorCrm          String         @map("doctor_crm")
  doctorUf           String         @map("doctor_uf")
  doctorSpecialty    String?        @map("doctor_specialty")

  status             String         @default("issued") // issued|canceled
  signedAt           DateTime?      @map("signed_at")

  // Sprint 19 — Assinatura digital (HMAC-SHA256) + QR de validação
  signatureHash      String?        @map("signature_hash")
  verifyToken        String?        @map("verify_token") @db.Text
  signatureExpiresAt DateTime?      @map("signature_expires_at")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([doctorId, createdAt])
  @@map("asos")
}

// EMPRESA — cadastro de empresas clientes (Medicina do Trabalho). NÃO faz login.
model Company {
  id                 String    @id @default(uuid())
  doctorId           String    @map("doctor_id")
