// IcodLife — Prisma Schema v7
// Banco: PostgreSQL 16
// LGPD: dados sensíveis marcados

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────────────────

enum GenderType {
  male
  female
  other
}

enum BloodType {
  A_PLUS   @map("A+")
  A_MINUS  @map("A-")
  B_PLUS   @map("B+")
  B_MINUS  @map("B-")
  AB_PLUS  @map("AB+")
  AB_MINUS @map("AB-")
  O_PLUS   @map("O+")
  O_MINUS  @map("O-")
  unknown
}

enum UserStatus {
  pending_verification
  active
  suspended
  deleted
}

enum FamilyRelationship {
  father
  mother
  sibling
  child
  grandparent
  grandchild
  spouse
  partner
  other
}

enum FamilyInviteStatus {
  pending
  accepted
  declined
  expired
}

enum ConsentType {
  terms_of_use
  data_processing
  data_sharing_b2b
  marketing
}

enum ShareAccessLevel {
  basic
  medium
  complete
  full
  custom
}

enum UserRole {
  user
  doctor
  admin
}

enum CrmStatus {
  pending
  verified
  suspended
  canceled
}

enum PatientDoctorStatus {
  pending
  active
  ended
}

enum ExamItemStatus {
  normal
  low
  high
  critical_low
  critical_high
  pending
}

enum AppointmentStatus {
  scheduled
  completed
  canceled
  no_show
}

enum BpClassification {
  normal
  elevado
  hipertensao1
  hipertensao2
  crise
}

enum SleepQuality {
  boa
  regular
  ruim
  insonia
}

enum PhysicalActivityBp {
  nenhuma
  leve
  moderada
  intensa
}

enum StressLevel {
  baixo
  moderado
  alto
}

enum RefractionRisk {
  none
  low
  moderate
  high
}

enum SurgeryStatus {
  scheduled
  completed
  canceled
}

enum VaccinationStatus {
  completed
  scheduled
  skipped
}

// ── Sprint 14: Glicemia ───────────────────────────────────────────────────────
enum GlucoseContext {
  fasting       // jejum
  pre_meal      // pré-refeição
  post_meal     // pós-refeição (1-2h)
  bedtime       // antes de dormir
  random        // aleatório
  post_exercise // pós-exercício
}

// ── GEOGRAPHY ─────────────────────────────────────────────────────────────────

model Country {
  id        Int     @id @default(autoincrement())
  icodeNum  String  @map("icode_num")
  name      String
  nameEn    String? @map("name_en")
  code      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  states    State[]
  users     User[]
  @@map("countries")
}

model Region {
  id        Int     @id @default(autoincrement())
  icodeNum  String  @map("icode_num")
  name      String
  states    State[]
  @@map("regions")
}

model State {
  id         Int     @id @default(autoincrement())
  icodeNum   String  @map("icode_num")
  name       String
  uf         String  @unique
  ibgeCode   String? @map("ibge_code")
  countryId  Int     @map("country_id")
  country    Country @relation(fields: [countryId], references: [id])
  regionId   Int     @map("region_id")
  region     Region  @relation(fields: [regionId], references: [id])
  users      User[]
  @@map("states")
}

model IcodeCounter {
  id        Int    @id @default(autoincrement())
  nextValue BigInt @default(1) @map("next_value")
  @@map("icode_counter")
}

// ── MODELS ────────────────────────────────────────────────────────────────────

model User {
  id                    String     @id @default(uuid())
  keycloakId            String?    @unique @map("keycloak_id")
  email                 String     @unique
  phone                 String?
  cpf                   String?    @unique
  fullName              String     @map("full_name")
  dateOfBirth           DateTime   @map("date_of_birth")
  gender                GenderType
  bloodType             BloodType  @default(unknown) @map("blood_type")
  isDonor               Boolean    @default(false) @map("is_donor")
  avatarUrl             String?    @map("avatar_url")
  status                UserStatus @default(pending_verification)
  passwordHash          String?    @map("password_hash")
  role                  UserRole   @default(user)

  icode          String? @unique
  icodeCountryId Int?    @map("icode_country_id")
  icodeCountry   Country? @relation(fields: [icodeCountryId], references: [id])
  icodeStateId   Int?    @map("icode_state_id")
  icodeState     State?  @relation(fields: [icodeStateId], references: [id])

  cityName    String? @map("city_name")
  stateCode   String? @map("state_code")
  ibgeCode    String? @map("ibge_code")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRel   String? @map("emergency_contact_rel")

  allergies         String[]
  chronicConditions String[] @map("chronic_conditions")

  lastLoginAt     DateTime? @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  consents                UserConsent[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  familyMembersOwned      FamilyMember[]           @relation("FamilyOwner")
  familyMembersLinked     FamilyMember[]           @relation("FamilyLinkedUser")
  healthRecords           HealthRecord[]
  appointments            Appointment[]
  medications             Medication[]
  medicationLogs          MedicationLog[]
  menstrualCycles         MenstrualCycle[]
  menstrualDailyLogs      MenstrualDailyLog[]
  shareTokens             ShareToken[]
  aiHealthChats           AiHealthChat[]
  notifications           Notification[]
  psychosocialAssessments PsychosocialAssessment[]
  mentalHealthAssessments MentalHealthAssessment[]
  ophthalmologyExams      OphthalmologyExam[]
  ophthalmologyHistory    OphthalmologyHistory[]
  examResults             ExamResult[]
  lifestyleProfile        LifestyleProfile?
  lifestyleSnapshots      LifestyleSnapshot[]
  bloodPressureReadings   BloodPressureReading[]
  doctor                  Doctor?
  patientDoctors          PatientDoctor[]
  surgeries               Surgery[]
  vaccinationRecords      VaccinationRecord[]
  bodyMetrics             BodyMetric[]
  staffRoles              DoctorStaff[]
  patientChatRooms        ChatRoom[]    @relation("PatientChatRooms")
  sentMessages            ChatMessage[] @relation("SentMessages")
  glucoseReadings         GlucoseReading[]
  hba1cReadings           HbA1cReading[]
  hostedRooms             TelemedicineRoom[] @relation("DoctorRooms")
  joinedRooms             TelemedicineRoom[] @relation("PatientRooms")
  deviceTokens            DeviceToken[]

  @@map("users")
}

// ── Sprint 16: Push Notifications (FCM) ───────────────────────────────────────
enum DevicePlatform {
  web
  android
  ios
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         // FCM registration token
  platform   DevicePlatform @default(web)
  deviceId   String?        @map("device_id")  // fingerprint do dispositivo para evitar duplicatas
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

model UserConsent {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType @map("consent_type")
  version     String
  accepted    Boolean
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  acceptedAt  DateTime    @default(now()) @map("accepted_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("user_consents")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  deviceInfo   Json?    @map("device_info")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  @@map("user_sessions")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model FamilyMember {
  id           String             @id @default(uuid())
  ownerId      String             @map("owner_id")
  owner        User               @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkedUserId String?            @map("linked_user_id")
  linkedUser   User?              @relation("FamilyLinkedUser", fields: [linkedUserId], references: [id])
  relationship FamilyRelationship
  fullName     String             @map("full_name")
  dateOfBirth  DateTime?          @map("date_of_birth")
  gender       GenderType?
  bloodType    BloodType?         @map("blood_type")
  isDonor      Boolean            @default(false) @map("is_donor")
  inviteToken  String?            @unique @map("invite_token")
  inviteStatus FamilyInviteStatus @default(pending) @map("invite_status")
  inviteEmail  String?            @map("invite_email")
  inviteExpiry DateTime?          @map("invite_expiry")
  allergies         String[]
  chronicConditions String[] @map("chronic_conditions")
  notes        String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  surgeries    Surgery[]

  @@index([ownerId])
  @@map("family_members")
}

model HealthRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  category    String   @default("general")
  title       String?
  description String?  @db.Text
  tags        String[]
  recordDate  DateTime? @map("record_date")
  isProcessed Boolean  @default(false) @map("is_processed")
  aiSummary   String?  @db.Text @map("ai_summary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@map("health_records")
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName      String            @map("doctor_name")
  specialty       String?
  cnesCode        String?           @map("cnes_code")
  appointmentAt   DateTime          @map("appointment_at")
  duration        Int               @default(30)
  status          AppointmentStatus @default(scheduled)
  telehealth      Boolean           @default(false)
  location        String?
  address         String?
  meetingUrl      String?           @map("meeting_url")
  patientDoctorId String?           @map("patient_doctor_id")
  patientDoctor   PatientDoctor?    @relation(fields: [patientDoctorId], references: [id])
  reminderMinutes Int?              @map("reminder_minutes")
  reminderAt      DateTime?         @map("reminder_at")
  color           String            @default("#DC2626")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([userId, appointmentAt])
  @@map("appointments")
}

model Medication {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  activeIngredient  String?  @map("active_ingredient")
  dosage            String?
  unit              String?
  form              String?
  frequency         String   @default("daily")
  timesPerDay       Int      @default(1) @map("times_per_day")
  scheduledTimes    String[] @map("scheduled_times")
  startDate         DateTime @map("start_date")
  endDate           DateTime? @map("end_date")
  isActive          Boolean  @default(true) @map("is_active")
  isContinuous      Boolean  @default(false) @map("is_continuous")
  prescribingDoctor String?  @map("prescribing_doctor")
  indication        String?
  stockQuantity     Int?     @map("stock_quantity")
  stockUnit         String?  @map("stock_unit")
  lowStockAlert     Int?     @map("low_stock_alert")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  logs MedicationLog[]

  @@index([userId, isActive])
  @@map("medications")
}

model MedicationLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String   @map("medication_id")
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt      DateTime @map("taken_at")
  wasSkipped   Boolean  @default(false) @map("was_skipped")
  skipReason   String?  @map("skip_reason")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, takenAt])
  @@map("medication_logs")
}

model MenstrualCycle {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  cycleLength  Int?      @map("cycle_length")
  periodLength Int?      @map("period_length")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  dailyLogs MenstrualDailyLog[]

  @@index([userId, startDate])
  @@map("menstrual_cycles")
}

model MenstrualDailyLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String?  @map("cycle_id")
  cycle       MenstrualCycle? @relation(fields: [cycleId], references: [id])
  date        DateTime
  flow        String?
  symptoms    String[]
  mood        String?
  temperature Decimal?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("menstrual_daily_logs")
}

model ShareToken {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String           @unique
  accessLevel   ShareAccessLevel @default(basic) @map("access_level")
  accessedByName String?         @map("accessed_by_name")
  expiresAt     DateTime?        @map("expires_at")
  revokedAt     DateTime?        @map("revoked_at")
  viewCount     Int              @default(0) @map("view_count")
  maxViews      Int?             @map("max_views")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([token])
  @@map("share_tokens")
}

model AiHealthChat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @map("session_id")
  role      String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@map("ai_health_chats")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @db.Text
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model ExamResult {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examDate         DateTime @map("exam_date")
  labName          String?  @map("lab_name")
  examType         String?  @map("exam_type")
  processingStatus String   @default("pending") @map("processing_status")
  aiRiskLevel      String?  @map("ai_risk_level")
  aiSummary        String?  @db.Text @map("ai_summary")
  aiFlags          String[] @map("ai_flags")
  sourceFileUrl    String?  @map("source_file_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  items ExamResultItem[]

  @@index([userId, examDate])
  @@map("exam_results")
}

model ExamResultItem {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  examId     String        @map("exam_id")
  exam       ExamResult    @relation(fields: [examId], references: [id], onDelete: Cascade)
  marker     String
  value      Decimal
  rawValue   String        @map("raw_value")
  unit       String?
  refMin     Decimal?      @map("ref_min")
  refMax     Decimal?      @map("ref_max")
  refSource  String?       @map("ref_source")
  status     ExamItemStatus @default(normal)
  examDate   DateTime      @map("exam_date")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId, marker, examDate])
  @@map("exam_result_items")
}

model LifestyleProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm      Decimal? @map("height_cm")
  weightKg      Decimal? @map("weight_kg")
  waistCm       Decimal? @map("waist_cm")
  bmi           Decimal?
  bmiCategory   String?  @map("bmi_category")
  systolicBp    Int?     @map("systolic_bp")
  diastolicBp   Int?     @map("diastolic_bp")
  smokingStatus String   @default("never") @map("smoking_status")
  cigarettesPerDay Int?  @map("cigarettes_per_day")
  smokingYears  Int?     @map("smoking_years")
  quitDate      DateTime? @map("quit_date")
  alcoholStatus String   @default("none") @map("alcohol_status")
  drinksPerWeek Int?     @map("drinks_per_week")
  alcoholTypes  String[] @map("alcohol_types")
  exerciseFrequency String? @map("exercise_frequency")
  exerciseTypes String[] @map("exercise_types")
  exerciseMinutes Int?   @map("exercise_minutes_per_session")
  sleepHoursAvg Decimal? @map("sleep_hours_avg")
  sleepQuality  Int?     @map("sleep_quality")
  stressLevel   Int?     @map("stress_level")
  moodAvg       Int?     @map("mood_avg")
  mentalHealthDiagnoses String[] @map("mental_health_diagnoses")
  therapyFrequency String? @map("therapy_frequency")
  sexuallyActive Boolean? @map("sexually_active")
  contraceptionType String? @map("contraception_type")
  stdProtection  Boolean? @map("std_protection")
  workHoursPerWeek Int?  @map("work_hours_per_week")
  workEnvironment String? @map("work_environment")
  ergonomicRisk  Int?    @map("ergonomic_risk")
  occupationalChemicals Boolean? @map("occupational_chemicals")
  dietType      String?  @map("diet_type")
  mealsPerDay   Int?     @map("meals_per_day")
  waterLitersDay Decimal? @map("water_liters_day")
  cityName      String?  @map("city_name")
  stateCode     String?  @map("state_code")
  ibgeCode      String?  @map("ibge_code")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("lifestyle_profiles")
}

model LifestyleSnapshot {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotAt DateTime @default(now()) @map("snapshot_at")
  heightCm   Decimal? @map("height_cm")
  weightKg   Decimal? @map("weight_kg")
  bmi        Decimal?
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, snapshotAt])
  @@map("lifestyle_snapshots")
}

model PsychosocialAssessment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentType String   @map("assessment_type")
  answers        Json
  score          Int?
  riskLevel      String?  @map("risk_level")
  aiAnalysis     String?  @db.Text @map("ai_analysis")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("psychosocial_assessments")
}

// Submódulo Saúde Mental (Medicina do Trabalho) — uma linha por aplicação de escala.
// Genérico para qualquer escala LIVRE (GAD-7, PHQ-9, CBI, WHO-5...). Dado sensível (LGPD).
model MentalHealthAssessment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleCode       String    @map("scale_code")      // "GAD7" | "PHQ9" | "CBI" | "WHO5" | "CONSOLIDATED"
  category        String                            // ansiedade | depressao | burnout | estresse | sono | bem_estar
  version         String    @default("1.0")

  answers         Json
  rawScore        Float?    @map("raw_score")
  normalizedScore Float?    @map("normalized_score")
  subscores       Json?
  severity        String?
  interpretation  String?   @db.Text                // LAUDO em texto

  flags           Json?                             // { suicideRisk, crisisRisk, ... }
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")

  appliedBy       String    @default("self") @map("applied_by") // self | clinician
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, scaleCode])
  @@map("mental_health_assessments")
}

model OphthalmologyExam {
  id                     String         @id @default(uuid())
  userId                 String         @map("user_id")
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphericalRight         Decimal?       @map("spherical_right")
  sphericalLeft          Decimal?       @map("spherical_left")
  cylinderRight          Decimal?       @map("cylinder_right")
  cylinderLeft           Decimal?       @map("cylinder_left")
  axisRight              Int?           @map("axis_right")
  axisLeft               Int?           @map("axis_left")
  additionRight          Decimal?       @map("addition_right")
  additionLeft           Decimal?       @map("addition_left")
  visualAcuityRight      String?        @map("visual_acuity_right")
  visualAcuityLeft       String?        @map("visual_acuity_left")
  astigmatismAxisRight   Int?           @map("astigmatism_axis_right")
  astigmatismAxisLeft    Int?           @map("astigmatism_axis_left")
  contrastScoreRight     Decimal?       @map("contrast_score_right")
  contrastScoreLeft      Decimal?       @map("contrast_score_left")
  estimatedMyopiaRight   Decimal?       @map("estimated_myopia_right")
  estimatedMyopiaLeft    Decimal?       @map("estimated_myopia_left")
  estimatedAstigRight    Decimal?       @map("estimated_astig_right")
  estimatedAstigLeft     Decimal?       @map("estimated_astig_left")
