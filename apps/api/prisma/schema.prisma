  patient       User?               @relation("PatientRooms", fields: [patientId], references: [id])
  appointmentId String?             @map("appointment_id")
  status        TelemedicineStatus  @default(waiting)
  patientName   String?             @map("patient_name")   // nome para sala pública
  reason        String?             @db.Text               // motivo da consulta
  startedAt     DateTime?           @map("started_at")
  endedAt       DateTime?           @map("ended_at")
  durationSecs  Int?                @map("duration_secs")
  notes         String?             @db.Text               // anotações do médico
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([doctorId, status])
  @@index([token])
  @@map("telemedicine_rooms")
}
