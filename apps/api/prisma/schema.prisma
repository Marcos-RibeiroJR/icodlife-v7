  naturezaJuridica   String?   @map("natureza_juridica")
  codigoFpas         String?   @map("codigo_fpas")
  codigoTerceiros    String?   @map("codigo_terceiros")
  regimeTributario   String?   @map("regime_tributario")
  porte              String?
  dataFundacao       DateTime? @map("data_fundacao")
  situacao           String    @default("ativa")

  // Endereço
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  pais               String?   @default("Brasil")
  latitude           Float?
  longitude          Float?

  // Contato
  telefonePrincipal  String?   @map("telefone_principal")
  telefoneRh         String?   @map("telefone_rh")
  whatsapp           String?
  emailRh            String?   @map("email_rh")
  emailSst           String?   @map("email_sst")
  site               String?

  // Trabalhistas (básico)
  qtdFuncionarios    Int?      @map("qtd_funcionarios")
  qtdTerceiros       Int?      @map("qtd_terceiros")
  qtdEstagiarios     Int?      @map("qtd_estagiarios")
  qtdAprendizes      Int?      @map("qtd_aprendizes")
  turnos             String?
  funcionamento24h   Boolean   @default(false) @map("funcionamento_24h")
  sindicatoPatronal  String?   @map("sindicato_patronal")
  sindicatoEmpregados String?  @map("sindicato_empregados")
  convencaoColetiva  String?   @map("convencao_coletiva")

  // Grupos complexos (JSON) — escaláveis e opcionais
  responsaveis       Json?     // { rh:{nome,cpf,tel,email}, sst:{...,creaCrm}, representante:{...,cargo} }
  medicina           Json?     // flags PCMSO/PGR/LTCAT/... + dados do PCMSO e PGR
  esocial            Json?     // config e credenciais eSocial
  financeiro         Json?     // plano, licenças, valores, renovação
  config             Json?     // logo, cores, idioma, fuso, ASO, notificações, IA
  metadata           Json?     // dados extras do enriquecimento (BrasilAPI: qsa, capital social, etc.)

  // Auditoria
  status             String    @default("active")
  version            Int       @default(1)
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

