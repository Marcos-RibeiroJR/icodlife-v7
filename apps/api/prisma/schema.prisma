// IcodLife — Prisma Schema v7
// Banco: PostgreSQL 16
// LGPD: dados sensíveis marcados

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────────────────

enum GenderType {
  male
  female
  other
}

enum BloodType {
  A_PLUS   @map("A+")
  A_MINUS  @map("A-")
  B_PLUS   @map("B+")
  B_MINUS  @map("B-")
  AB_PLUS  @map("AB+")
  AB_MINUS @map("AB-")
  O_PLUS   @map("O+")
  O_MINUS  @map("O-")
  unknown
}

enum UserStatus {
  pending_verification
  active
  suspended
  deleted
}

enum FamilyRelationship {
  father
  mother
  sibling
  child
  grandparent
  grandchild
  spouse
  partner
  other
}

enum FamilyInviteStatus {
  pending
  accepted
  declined
  expired
}

enum ConsentType {
  terms_of_use
  data_processing
  data_sharing_b2b
  marketing
}

enum ShareAccessLevel {
  basic
  medium
  complete
  full
  custom
}

enum UserRole {
  user
  doctor
  admin
}

enum CrmStatus {
  pending
  verified
  suspended
  canceled
}

enum PatientDoctorStatus {
  pending
  active
  ended
}

enum ExamItemStatus {
  normal
  low
  high
  critical_low
  critical_high
  pending
}

enum AppointmentStatus {
  scheduled
  completed
  canceled
  no_show
}

enum BpClassification {
  normal
  elevado
  hipertensao1
  hipertensao2
  crise
}

enum SleepQuality {
  boa
  regular
  ruim
  insonia
}

enum PhysicalActivityBp {
  nenhuma
  leve
  moderada
  intensa
}

enum StressLevel {
  baixo
  moderado
  alto
}

enum RefractionRisk {
  none
  low
  moderate
  high
}

enum SurgeryStatus {
  scheduled
  completed
  canceled
}

enum VaccinationStatus {
  completed
  scheduled
  skipped
}

// ── GEOGRAPHY ─────────────────────────────────────────────────────────────────

model Country {
  id        Int     @id @default(autoincrement())
  icodeNum  String  @map("icode_num")
  name      String
  nameEn    String? @map("name_en")
  code      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  states    State[]
  users     User[]
  @@map("countries")
}

model Region {
  id        Int     @id @default(autoincrement())
  icodeNum  String  @map("icode_num")
  name      String
  states    State[]
  @@map("regions")
}

model State {
  id         Int     @id @default(autoincrement())
  icodeNum   String  @map("icode_num")
  name       String
  uf         String  @unique
  ibgeCode   String? @map("ibge_code")
  countryId  Int     @map("country_id")
  country    Country @relation(fields: [countryId], references: [id])
  regionId   Int     @map("region_id")
  region     Region  @relation(fields: [regionId], references: [id])
  users      User[]
  @@map("states")
}

model IcodeCounter {
  id        Int    @id @default(autoincrement())
  nextValue BigInt @default(1) @map("next_value")
  @@map("icode_counter")
}

// ── MODELS ────────────────────────────────────────────────────────────────────

model User {
  id                    String     @id @default(uuid())
  keycloakId            String?    @unique @map("keycloak_id")
  email                 String     @unique
  phone                 String?
  cpf                   String?    @unique
  fullName              String     @map("full_name")
  dateOfBirth           DateTime   @map("date_of_birth")
  gender                GenderType
  bloodType             BloodType  @default(unknown) @map("blood_type")
  isDonor               Boolean    @default(false) @map("is_donor")
  avatarUrl             String?    @map("avatar_url")
  status                UserStatus @default(pending_verification)
  passwordHash          String?    @map("password_hash")
  role                  UserRole   @default(user)

  icode          String? @unique
  icodeCountryId Int?    @map("icode_country_id")
  icodeCountry   Country? @relation(fields: [icodeCountryId], references: [id])
  icodeStateId   Int?    @map("icode_state_id")
  icodeState     State?  @relation(fields: [icodeStateId], references: [id])

  cityName    String? @map("city_name")
  stateCode   String? @map("state_code")
  ibgeCode    String? @map("ibge_code")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRel   String? @map("emergency_contact_rel")

  allergies         String[]
  chronicConditions String[] @map("chronic_conditions")

  lastLoginAt     DateTime? @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  consents                UserConsent[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  familyMembersOwned      FamilyMember[]           @relation("FamilyOwner")
  familyMembersLinked     FamilyMember[]           @relation("FamilyLinkedUser")
  healthRecords           HealthRecord[]
  appointments            Appointment[]
  medications             Medication[]
  medicationLogs          MedicationLog[]
  menstrualCycles         MenstrualCycle[]
  menstrualDailyLogs      MenstrualDailyLog[]
  shareTokens             ShareToken[]
  aiHealthChats           AiHealthChat[]
  notifications           Notification[]
  psychosocialAssessments PsychosocialAssessment[]
  ophthalmologyExams      OphthalmologyExam[]
  ophthalmologyHistory    OphthalmologyHistory[]
  examResults             ExamResult[]
  lifestyleProfile        LifestyleProfile?
  lifestyleSnapshots      LifestyleSnapshot[]
  bloodPressureReadings   BloodPressureReading[]
  doctor                  Doctor?
  patientDoctors          PatientDoctor[]
  surgeries               Surgery[]
  vaccinationRecords      VaccinationRecord[]

  @@map("users")
}

model UserConsent {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType @map("consent_type")
  version     String
  accepted    Boolean
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  acceptedAt  DateTime    @default(now()) @map("accepted_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("user_consents")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  deviceInfo   Json?    @map("device_info")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  @@map("user_sessions")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model FamilyMember {
  id           String             @id @default(uuid())
  ownerId      String             @map("owner_id")
  owner        User               @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkedUserId String?            @map("linked_user_id")
  linkedUser   User?              @relation("FamilyLinkedUser", fields: [linkedUserId], references: [id])
  relationship FamilyRelationship
  fullName     String             @map("full_name")
  dateOfBirth  DateTime?          @map("date_of_birth")
  gender       GenderType?
  bloodType    BloodType?         @map("blood_type")
  isDonor      Boolean            @default(false) @map("is_donor")
  inviteToken  String?            @unique @map("invite_token")
  inviteStatus FamilyInviteStatus @default(pending) @map("invite_status")
  inviteEmail  String?            @map("invite_email")
  inviteExpiry DateTime?          @map("invite_expiry")
  allergies         String[]
  chronicConditions String[] @map("chronic_conditions")
  notes        String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  surgeries    Surgery[]

  @@index([ownerId])
  @@map("family_members")
}

model HealthRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  category    String   @default("general")
  title       String?
  description String?  @db.Text
  tags        String[]
  recordDate  DateTime? @map("record_date")
  isProcessed Boolean  @default(false) @map("is_processed")
  aiSummary   String?  @db.Text @map("ai_summary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@map("health_records")
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName      String            @map("doctor_name")
  specialty       String?
  cnesCode        String?           @map("cnes_code")
  appointmentAt   DateTime          @map("appointment_at")
  duration        Int               @default(30)
  status          AppointmentStatus @default(scheduled)
  telehealth      Boolean           @default(false)
  location        String?
  address         String?
  meetingUrl      String?           @map("meeting_url")
  patientDoctorId String?           @map("patient_doctor_id")
  patientDoctor   PatientDoctor?    @relation(fields: [patientDoctorId], references: [id])
  reminderMinutes Int?              @map("reminder_minutes")
  reminderAt      DateTime?         @map("reminder_at")
  color           String            @default("#DC2626")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([userId, appointmentAt])
  @@map("appointments")
}

model Medication {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  activeIngredient  String?  @map("active_ingredient")
  dosage            String?
  unit              String?
  form              String?
  frequency         String   @default("daily")
  timesPerDay       Int      @default(1) @map("times_per_day")
  scheduledTimes    String[] @map("scheduled_times")
  startDate         DateTime @map("start_date")
  endDate           DateTime? @map("end_date")
  isActive          Boolean  @default(true) @map("is_active")
  isContinuous      Boolean  @default(false) @map("is_continuous")
  prescribingDoctor String?  @map("prescribing_doctor")
  indication        String?
  stockQuantity     Int?     @map("stock_quantity")
  stockUnit         String?  @map("stock_unit")
  lowStockAlert     Int?     @map("low_stock_alert")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  logs MedicationLog[]

  @@index([userId, isActive])
  @@map("medications")
}

model MedicationLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String   @map("medication_id")
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt      DateTime @map("taken_at")
  wasSkipped   Boolean  @default(false) @map("was_skipped")
  skipReason   String?  @map("skip_reason")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, takenAt])
  @@map("medication_logs")
}

model MenstrualCycle {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  cycleLength  Int?      @map("cycle_length")
  periodLength Int?      @map("period_length")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  dailyLogs MenstrualDailyLog[]

  @@index([userId, startDate])
  @@map("menstrual_cycles")
}

model MenstrualDailyLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String?  @map("cycle_id")
  cycle       MenstrualCycle? @relation(fields: [cycleId], references: [id])
  date        DateTime
  flow        String?
  symptoms    String[]
  mood        String?
  temperature Decimal?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("menstrual_daily_logs")
}

model ShareToken {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String           @unique
  accessLevel   ShareAccessLevel @default(basic) @map("access_level")
  accessedByName String?         @map("accessed_by_name")
  expiresAt     DateTime?        @map("expires_at")
  revokedAt     DateTime?        @map("revoked_at")
  viewCount     Int              @default(0) @map("view_count")
  maxViews      Int?             @map("max_views")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([token])
  @@map("share_tokens")
}

model AiHealthChat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @map("session_id")
  role      String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@map("ai_health_chats")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @db.Text
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model ExamResult {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examDate         DateTime @map("exam_date")
  labName          String?  @map("lab_name")
  examType         String?  @map("exam_type")
  processingStatus String   @default("pending") @map("processing_status")
  aiRiskLevel      String?  @map("ai_risk_level")
  aiSummary        String?  @db.Text @map("ai_summary")
  aiFlags          String[] @map("ai_flags")
  sourceFileUrl    String?  @map("source_file_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  items ExamResultItem[]

  @@index([userId, examDate])
  @@map("exam_results")
}

model ExamResultItem {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  examId     String        @map("exam_id")
  exam       ExamResult    @relation(fields: [examId], references: [id], onDelete: Cascade)
  marker     String
  value      Decimal
  rawValue   String        @map("raw_value")
  unit       String?
  refMin     Decimal?      @map("ref_min")
  refMax     Decimal?      @map("ref_max")
  refSource  String?       @map("ref_source")
  status     ExamItemStatus @default(normal)
  examDate   DateTime      @map("exam_date")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId, marker, examDate])
  @@map("exam_result_items")
}

model LifestyleProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm      Decimal? @map("height_cm")
  weightKg      Decimal? @map("weight_kg")
  bmi           Decimal?
  bmiCategory   String?  @map("bmi_category")
  smokingStatus String   @default("never") @map("smoking_status")
  cigarettesPerDay Int?  @map("cigarettes_per_day")
  smokingYears  Int?     @map("smoking_years")
  quitDate      DateTime? @map("quit_date")
  alcoholStatus String   @default("none") @map("alcohol_status")
  drinksPerWeek Int?     @map("drinks_per_week")
  alcoholTypes  String[] @map("alcohol_types")
  exerciseFrequency String? @map("exercise_frequency")
  exerciseTypes String[] @map("exercise_types")
  exerciseMinutes Int?   @map("exercise_minutes_per_session")
  sleepHoursAvg Decimal? @map("sleep_hours_avg")
  sleepQuality  String?  @map("sleep_quality")
  stressLevel   String?  @map("stress_level")
  dietType      String?  @map("diet_type")
  waterLitersDay Decimal? @map("water_liters_day")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("lifestyle_profiles")
}

model LifestyleSnapshot {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotAt DateTime @default(now()) @map("snapshot_at")
  heightCm   Decimal? @map("height_cm")
  weightKg   Decimal? @map("weight_kg")
  bmi        Decimal?
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, snapshotAt])
  @@map("lifestyle_snapshots")
}

model PsychosocialAssessment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentType String   @map("assessment_type")
  answers        Json
  score          Int?
  riskLevel      String?  @map("risk_level")
  aiAnalysis     String?  @db.Text @map("ai_analysis")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("psychosocial_assessments")
}

model OphthalmologyExam {
  id                     String         @id @default(uuid())
  userId                 String         @map("user_id")
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphericalRight         Decimal?       @map("spherical_right")
  sphericalLeft          Decimal?       @map("spherical_left")
  cylinderRight          Decimal?       @map("cylinder_right")
  cylinderLeft           Decimal?       @map("cylinder_left")
  axisRight              Int?           @map("axis_right")
  axisLeft               Int?           @map("axis_left")
  additionRight          Decimal?       @map("addition_right")
  additionLeft           Decimal?       @map("addition_left")
  visualAcuityRight      String?        @map("visual_acuity_right")
  visualAcuityLeft       String?        @map("visual_acuity_left")
  astigmatismAxisRight   Int?           @map("astigmatism_axis_right")
  astigmatismAxisLeft    Int?           @map("astigmatism_axis_left")
  contrastScoreRight     Decimal?       @map("contrast_score_right")
  contrastScoreLeft      Decimal?       @map("contrast_score_left")
  estimatedMyopiaRight   Decimal?       @map("estimated_myopia_right")
  estimatedMyopiaLeft    Decimal?       @map("estimated_myopia_left")
  estimatedAstigRight    Decimal?       @map("estimated_astig_right")
  estimatedAstigLeft     Decimal?       @map("estimated_astig_left")
  confidenceScore        Decimal?       @map("confidence_score")
  riskLevel              RefractionRisk @default(none) @map("risk_level")
  reportSummary          String?        @db.Text @map("report_summary")
  recommendations        String[]
  symptoms               String[]
  userAge                Int?           @map("user_age")
  completedAt            DateTime?      @map("completed_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("ophthalmology_exams")
}

model OphthalmologyHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId         String?  @map("exam_id")
  doctorName     String?  @map("doctor_name")
  crmNumber      String?  @map("crm_number")
  sphericalRight Decimal? @map("spherical_right")
  sphericalLeft  Decimal? @map("spherical_left")
  cylinderRight  Decimal? @map("cylinder_right")
  cylinderLeft   Decimal? @map("cylinder_left")
  axisRight      Int?     @map("axis_right")
  axisLeft       Int?     @map("axis_left")
  additionRight  Decimal? @map("addition_right")
  additionLeft   Decimal? @map("addition_left")
  diagnoses      String[]
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("ophthalmology_history")
}

model BloodPressureReading {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  systolic         Int
  diastolic        Int
  pulse            Int?
  measuredAt       DateTime           @map("measured_at")
  arm              String?
  classification   BpClassification   @default(normal)
  sleepQuality     SleepQuality?      @map("sleep_quality")
  alcoholConsumed  Boolean?           @default(false) @map("alcohol_consumed")
  heavyMeal        Boolean?           @default(false) @map("heavy_meal")
  highSodium       Boolean?           @default(false) @map("high_sodium")
  physicalActivity PhysicalActivityBp? @map("physical_activity")
  stressLevel      StressLevel?       @map("stress_level")
  caffeine         Boolean?           @default(false)
  tookMedication   Boolean?           @default(false) @map("took_medication")
  headache         Boolean?           @default(false)
  dizziness        Boolean?           @default(false)
  smoking          Boolean?           @default(false)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([userId, measuredAt])
  @@map("blood_pressure_readings")
}

model DoctorCounter {
  id        Int    @id @default(autoincrement())
  uf        String @unique
  nextValue Int    @default(1) @map("next_value")

  @@map("doctor_counter")
}

model Doctor {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId      String    @unique @map("doctor_id")
  crm           String
  uf            String
  crmStatus     CrmStatus @default(pending) @map("crm_status")
  cfmVerifiedAt DateTime? @map("cfm_verified_at")
  specialties   String[]
  healthPlans   String[]  @map("health_plans")
  bio           String?   @db.Text
  consultPrice  Decimal?  @map("consult_price")
  addressCity   String?   @map("address_city")
  addressState  String?   @map("address_state")
  phone         String?
  website       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  patients      PatientDoctor[]

  @@index([uf, crmStatus])
  @@map("doctors")
}

model PatientDoctor {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId     String?             @map("doctor_id")
  doctor       Doctor?             @relation(fields: [doctorId], references: [id])
  externalCrm  String?             @map("external_crm")
  externalUf   String?             @map("external_uf")
  externalName String?             @map("external_name")
  specialty    String?
  status       PatientDoctorStatus @default(active)
  connectedAt  DateTime            @default(now()) @map("connected_at")
  endedAt      DateTime?           @map("ended_at")
  notes        String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  appointments Appointment[]

  @@unique([userId, doctorId])
  @@map("patient_doctors")
}

model Surgery {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMemberId   String?       @map("family_member_id")
  familyMember     FamilyMember? @relation(fields: [familyMemberId], references: [id])
  procedureName    String        @map("procedure_name")
  procedureCode    String?       @map("procedure_code")
  status           SurgeryStatus @default(scheduled)
  scheduledAt      DateTime?     @map("scheduled_at")
  performedAt      DateTime?     @map("performed_at")
  hospitalName     String?       @map("hospital_name")
  surgeonName      String?       @map("surgeon_name")
  anesthesiaType   String?       @map("anesthesia_type")
  technique        String?
  durationMinutes  Int?          @map("duration_minutes")
  hospitalDays     Int?          @map("hospital_days")
  returnToWorkDays Int?          @map("return_to_work_days")
  bloodLossMl      Int?          @map("blood_loss_ml")
  indication       String?       @db.Text
  complications    String[]
  implants         String[]
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([userId, performedAt])
  @@map("surgeries")
}

model Vaccine {
  id               String    @id @default(uuid())
  name             String
  tradeName        String?   @map("trade_name")
  cvxCode          String?   @unique @map("cvx_code")
  diseases         String[]
  recommendedDoses Int       @default(1) @map("recommended_doses")
  intervalDays     Int?      @map("interval_days")
  boosterYears     Int?      @map("booster_years")
  ageGroups        String[]  @map("age_groups")
  calendar         String    @default("PNI")
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?   @db.Text
  records          VaccinationRecord[]

  @@map("vaccines")
}

model VaccinationRecord {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccineId    String            @map("vaccine_id")
  vaccine      Vaccine           @relation(fields: [vaccineId], references: [id])
  doseNumber   Int               @default(1) @map("dose_number")
  status       VaccinationStatus @default(completed)
  appliedAt    DateTime?         @map("applied_at")
  scheduledAt  DateTime?         @map("scheduled_at")
  lotNumber    String?           @map("lot_number")
  location     String?
  professional String?
  manufacturer String?
  nextDoseAt   DateTime?         @map("next_dose_at")
  notes        String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([userId, vaccineId])
  @@index([userId, appliedAt])
  @@map("vaccination_records")
}
