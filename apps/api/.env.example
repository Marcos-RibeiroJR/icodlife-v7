# apps/api/.env.example
# Copie para .env e preencha com seus valores

NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://icodlife:icodlife_dev_secret@localhost:5432/icodlife

# MongoDB
MONGODB_URI=mongodb://icodlife:icodlife_dev_secret@localhost:27017/icodlife

# TimescaleDB
TIMESCALE_URL=postgresql://icodlife:icodlife_dev_secret@localhost:5433/icodlife_metrics

# Redis
REDIS_URL=redis://:icodlife_dev_secret@localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=icodlife
MINIO_SECRET_KEY=icodlife_dev_secret_key
MINIO_BUCKET=icodlife-records

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=icodlife
KEYCLOAK_CLIENT_ID=icodlife-api
KEYCLOAK_CLIENT_SECRET=change_in_production

# JWT
JWT_SECRET=change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@icodlife.com.br
SMTP_PASS=your_app_password

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# OpenAI (para o chatbot em produção)
OPENAI_API_KEY=sk-...

# Encryption (AES-256 para CPF e dados sensíveis)
ENCRYPTION_KEY=32_chars_hex_key_change_in_prod!

# ── Sprint 16: Firebase FCM (Push Notifications) ─────────────────────────────
# Obtenha em: Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_PROJECT_ID=icodlife-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@icodlife-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXXX\n-----END RSA PRIVATE KEY-----\n"
